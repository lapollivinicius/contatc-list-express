<section id="login_section">
  <div class="container">
    <div>

      <div class="hero">
        <h1 class="hero_title">KOSHO</h1>
        <p class="hero_subtitle">a dev club</p>
      </div>

      <form action="/api/register" class="form_login">
        <p>Create an account to see the secrets</p>

        <label for="name" class="form_login_label">
          <p>▶</p>
          <input type="text" autocomplete="off" spellcheck="false" maxlength="50" placeholder="name">
        </label>

        <label for="email" class="form_login_label">
          <p>▶</p>
          <input type="text" autocomplete="off" spellcheck="false" maxlength="50" placeholder="email">
        </label>

        <label for="username" class="form_login_label">
          <p>▶</p>
          <input type="text" autocomplete="off" spellcheck="false" maxlength="50" placeholder="username">
        </label>

        <label for="password" class="form_login_label">
          <p>▶</p>
          <input type="password" autocomplete="off" spellcheck="false" maxlength="50" placeholder="password">
        </label>

        <p class="login_message"></p>

        <div>
          <button class="hover">REGISTER</button>
          <a href="/login" class="hover">login</a>
        </div>
      </form>

    </div>
  </div>
</section>