<section class="section-posts-list">
  <div class="container">
    <div class="wrapper-posts-list">

      <div class="hud-container">

        <p>✱ THIS WEEK HAVE 20 POSTS</p>

        <form action="" class="search-form">

          <label for="search" class="search">
            <p>☌</p>
            <input type="search" autocomplete="off" spellcheck="false" maxlength="100" name="search" id="search" placeholder="Search...">
          </label>

          <button class="hover">SEARCH</button>

        </form>
        
      </div>

      <div class="post-container">

        <div class="post">

          <div class="post-content hover" onclick="OpenComments(this)">
            <p class="post-head">DISCUSSING▶Technology</p>

              <p class="post-subject">
                <span class="post-username">@username </span>
                Lorem ipsum dolor sit amet consectetur adipisicing elit. Perferendis assumenda possimus animi
                excepturi maxime similique esse, amet eos recusandae adipisci, deleniti voluptatem cumque dolores
                doloribus nulla maiores aspernatur explicabo sit?
              </p>

          </div>

          <div class="comment-container">

            <div class="comment hover">
              <p class="comment-symbol">L</p>
              <div class="comment-content">
                <p class="comment-subject">
                  <span class="post-username">@username </span>
                  Lorem ipsum dolor sit amet consectetur adipisicing elit. Perferendis assumenda possimus animi
                  excepturi maxime similique esse, amet eos recusandae adipisci, deleniti voluptatem cumque dolores
                  doloribus nulla maiores aspernatur explicabo sit?
                </p>
              </div>
            </div>

            <form class="reply-container">
              <label for="reply" class="reply">
                <p>▶</p>
                <input class="reply-input" autocomplete="off" maxlength="100" spellcheck="false" type="text" name="reply" id="reply" placeholder="Reply...">
              </label>
              <button class="hover">SEND</button>
            </form>

          </div>

        </div>

        <div class="ads post hover">
          <div class="post-content">
            <p class="post-ads-username">ADS▶MERCADO LIVRE</p>
            <p class="post-subject">
              <span class="post-ads-username">@MERCADOLIVRE </span>
              APROVEITE AS PROMOÇÕES DO DIA 8.8
            </p>
          </div>
        </div>

      </div>
    </div>
</section>